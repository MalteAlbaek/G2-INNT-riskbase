{
  "name": "riskbase",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": ["apps/web", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local --schema public > ./packages/db-types/src/database.ts"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5"
  }
}
